generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(cuid())
  subdomain        String   @unique
  companyName      String
  subscriptionPlan PlanType @default(BASIC)
  isActive         Boolean  @default(true)
  databaseUrl      String
  customDomain     String?  @unique
  logoUrl          String?
  primaryColor     String?  @default("#007bff")
  secondaryColor   String?  @default("#6c757d")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id                       String                @id @default(cuid())
  clerkId                  String                @unique
  email                    String                @unique
  name                     String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  auditLogs                AuditLog[]
  contractResponsibilities ContractResponsible[]
  badgesAssigned           NFCBadge[]            @relation("BadgeAssignedBy")
  badgesRevoked            NFCBadge[]            @relation("BadgeRevokedBy")
  overtimeApprovalsGiven   OvertimeApproval[]    @relation("ApprovedBy")
  transferRequestsApproved TransferRequest[]     @relation("ApprovedBy")
  transferRequestsMade     TransferRequest[]     @relation("RequestedBy")

  @@map("users")
}

model Contract {
  id               String                @id @default(cuid())
  name             String
  code             String                @unique
  isActive         Boolean               @default(true)
  workdayHours     Float
  includesWeekends Boolean               @default(false)
  includesHolidays Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  functions        ContractFunction[]
  responsibles     ContractResponsible[]
  employees        Employee[]
  hourPlannings    HourPlanning[]
  nfcCollections   NFCCollection[]
}

model ContractResponsible {
  contractId String
  userId     String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@id([contractId, userId])
}

model ContractFunction {
  id                String             @id @default(cuid())
  contractId        String
  name              String
  isActive          Boolean            @default(true)
  contract          Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employees         Employee[]
  requiredTrainings RequiredTraining[]

  @@unique([contractId, name])
}

model CompanyFunction {
  id        String     @id @default(cuid())
  name      String     @unique
  laborType LaborType
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[] @relation("EmployeeCompanyFunction")
}

model Employee {
  id                       String             @id @default(cuid())
  name                     String
  registration             String?
  company                  String?
  cpf                      String             @unique
  rg                       String?
  birthDate                DateTime?
  admissionDate            DateTime?
  dismissalDate            DateTime?
  status                   EmployeeStatus @default(ACTIVE)
  workplace                String?
  shift                    String?
  phone                    String?
  email                    String?
  address                  Json?
  nationality              String?
  naturalness              String?
  gender                   String?
  maritalStatus            String?
  sexo                     String?
  estadoCivil              String?
  educationLevel           String?
  pis                      String?
  ctps                     String?
  ctpsSeries               String?
  ctpsUf                   String?
  voterTitle               String?
  voterZone                String?
  voterSection             String?
  reservist                String?
  reservistCategory        String?
  cnh                      String?
  cnhCategory              String?
  cnhValidity              DateTime?
  motherName               String?
  fatherName               String?
  dependents               Json?
  notes                    String?
  employmentHistory        Json?
  avatar                   String?
  centroCusto              String?
  obra                     String?
  primeiraExperiencia      DateTime?
  segundaExperiencia       DateTime?
  previsaoObra             DateTime?
  mo                       String?
  horasNormaisTrabalhadas  Float?
  horasExtrasTrabalhadas   Float?
  horasNoturnasTrabalhadas Float?
  localAlojado             String?
  pontoReferencia          String?
  statusBancodoc           String?
  efetivoRDO               Boolean?
  isActive                 Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  nfcCardId                String?            @unique
  currentContractId        String?
  currentFunctionId        String?
  companyFunctionId        String?
  contractId               String?
  contractAssignmentDate   DateTime?
  asos                     ASO[]
  companyFunction          CompanyFunction?   @relation("EmployeeCompanyFunction", fields: [companyFunctionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentContract          Contract?          @relation(fields: [currentContractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentFunction          ContractFunction?  @relation(fields: [currentFunctionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trainings                EmployeeTraining[]
  nfcBadge                 NFCBadge?          @relation("EmployeeNFCBadge")
  timeRecords              TimeRecord[]
  transferHistory          TransferHistory[]
  transferRequests         TransferRequest[]  @relation("EmployeeTransferRequests")
  workforceEntries         WorkforceEntry[]   @relation("EmployeeWorkforceEntries")

  @@unique([registration, company])
}

model TransferRequest {
  id            String         @id @default(cuid())
  employeeId    String
  toContractId  String
  toFunctionId  String
  requestedById String
  approvedById  String?
  status        TransferStatus @default(PENDING)
  scheduledDate DateTime
  completedAt   DateTime?
  approvedBy    User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  employee      Employee       @relation("EmployeeTransferRequests", fields: [employeeId], references: [id])
  requestedBy   User           @relation("RequestedBy", fields: [requestedById], references: [id])
}

model TransferHistory {
  id         String    @id @default(cuid())
  employeeId String
  contractId String
  functionId String
  startDate  DateTime
  endDate    DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model ASO {
  id         String    @id @default(cuid())
  employeeId String
  examType   ASOType
  examDate   DateTime
  validUntil DateTime
  result     ASOResult
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model Training {
  id             String             @id @default(cuid())
  name           String             @unique
  validityMonths Int
  employeeHas    EmployeeTraining[]
  requiredFor    RequiredTraining[]
}

model RequiredTraining {
  functionId String
  trainingId String
  function   ContractFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  training   Training         @relation(fields: [trainingId], references: [id])

  @@id([functionId, trainingId])
}

model EmployeeTraining {
  id            String   @id @default(cuid())
  employeeId    String
  trainingId    String
  completedDate DateTime
  validUntil    DateTime
  employee      Employee @relation(fields: [employeeId], references: [id])
  training      Training @relation(fields: [trainingId], references: [id])
}

model HourPlanning {
  id            String   @id @default(cuid())
  contractId    String
  date          DateTime @db.Date
  regularHours  Float    @default(0)
  overtimeHours Float    @default(0)
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, date])
}

model OvertimeApproval {
  id           String         @id @default(cuid())
  contractId   String
  date         DateTime       @db.Date
  status       ApprovalStatus @default(PENDING)
  approvedById String?
  approvedBy   User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
}

model NFCCollection {
  id          String      @id @default(cuid())
  contractId  String
  collectorId String
  date        DateTime    @db.Date
  createdAt   DateTime    @default(now())
  contract    Contract    @relation(fields: [contractId], references: [id])
  records     NFCRecord[]
}

model NFCRecord {
  id           String        @id @default(cuid())
  collectionId String
  nfcCardId    String
  timestamp    DateTime
  cpfFallback  String?
  collection   NFCCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model TimeRecord {
  id         String       @id @default(cuid())
  employeeId String
  date       DateTime     @db.Date
  clockIn    DateTime?
  clockOut   DateTime?
  source     RecordSource
  isEdited   Boolean      @default(false)
  employee   Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date, source])
}

model WorkforceEntry {
  id                   String          @id @default(cuid())
  employeeId           String
  checkInTime          DateTime?
  checkOutTime         DateTime?
  status               WorkforceStatus @default(PRESENT)
  location             String?
  isLate               Boolean         @default(false)
  hoursWorked          Float?          @default(0)
  contractName         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  contractId           String?
  employeeName         String?
  employeeRegistration String?
  functionId           String?
  functionName         String?
  nfcCardId            String?
  employee             Employee        @relation("EmployeeWorkforceEntries", fields: [employeeId], references: [id])

  @@unique([employeeId, createdAt])
}

model NFCBadge {
  id             String         @id @default(cuid())
  badgeId        String         @unique
  employeeId     String?        @unique
  status         NFCBadgeStatus @default(AVAILABLE)
  isActive       Boolean        @default(true)
  assignedAt     DateTime?
  revokedAt      DateTime?
  assignedBy     String?
  revokedBy      String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assignedByUser User?          @relation("BadgeAssignedBy", fields: [assignedBy], references: [id])
  employee       Employee?      @relation("EmployeeNFCBadge", fields: [employeeId], references: [id])
  revokedByUser  User?          @relation("BadgeRevokedBy", fields: [revokedBy], references: [id])

  @@index([badgeId])
  @@index([employeeId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entityId  String
  details   Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum PlanType {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  TENANT_ADMIN
  HR
  PLANNING
  SAFETY
  CONTRACT_MANAGER
  SUPERVISOR
  OPERATOR
}

enum LaborType {
  DIRETO
  INDIRETO
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ASOType {
  ADMISSIONAL
  PERIODIC
  FUNCTION_CHANGE
  RETURN_TO_WORK
  DISMISSAL
}

enum ASOResult {
  FIT
  UNFIT
  FIT_WITH_RESTRICTIONS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecordSource {
  NFC_PROCESSED
  PAYROLL_IMPORTED
}

enum WorkforceStatus {
  PRESENT
  ABSENT
  LATE
  LEFT
}

enum NFCBadgeStatus {
  AVAILABLE
  ASSIGNED
  REVOKED
  LOST
  DAMAGED
  EXPIRED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

// Configurações do Usuário
model UserSettings {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  personalSettings      PersonalSettings?
  interfaceSettings     InterfaceSettings?
  notificationSettings  NotificationSettings?

  @@map("user_settings")
}

model PersonalSettings {
  id       String      @id @default(cuid())
  userId   String      @unique
  name     String?
  email    String?
  phone    String?
  language String      @default("pt-BR")
  timezone String      @default("America/Sao_Paulo")
  theme    String      @default("system")
  avatar   String?
  user     UserSettings @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personal_settings")
}

model InterfaceSettings {
  id                String      @id @default(cuid())
  userId            String      @unique
  dashboardLayout   String      @default("grid")
  sidebarCollapsed  Boolean     @default(false)
  showNotifications Boolean     @default(true)
  showQuickActions  Boolean     @default(true)
  autoRefresh       Boolean     @default(true)
  refreshInterval   Int         @default(30)
  compactMode       Boolean     @default(false)
  showAnimations    Boolean     @default(true)
  colorScheme       String      @default("blue")
  user              UserSettings @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interface_settings")
}

model NotificationSettings {
  id              String      @id @default(cuid())
  userId          String      @unique
  pushEnabled     Boolean     @default(true)
  pushWorkHours   Boolean     @default(true)
  pushAfterHours  Boolean     @default(false)
  emailEnabled    Boolean     @default(true)
  emailDaily      Boolean     @default(false)
  emailWeekly     Boolean     @default(true)
  emailUrgent     Boolean     @default(true)
  newAssignments  Boolean     @default(true)
  scheduleChanges Boolean     @default(true)
  systemUpdates   Boolean     @default(false)
  reminders       Boolean     @default(true)
  alerts          Boolean     @default(true)
  quietHours      Boolean     @default(true)
  quietStart      String      @default("22:00")
  quietEnd        String      @default("07:00")
  user            UserSettings @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ========================================
// SISTEMA DE ORÇAMENTOS
// ========================================

model Budget {
  id                String           @id @default(cuid())
  name              String
  code              String           @unique
  description       String?
  status            BudgetStatus     @default(DRAFT)
  version           Int              @default(1)
  totalValue        Float            @default(0)
  currency          String           @default("BRL")
  startDate         DateTime?
  endDate           DateTime?
  clientName        String?
  projectType       String?
  createdBy         String
  approvedBy        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relacionamentos
  sections          BudgetSection[]
  formulas          BudgetFormula[]
  attachments       BudgetAttachment[]
  versions          BudgetVersion[]
  approvals         BudgetApproval[]
  
  @@map("budgets")
}

model BudgetSection {
  id          String        @id @default(cuid())
  budgetId    String
  name        String
  type        SectionType
  order       Int
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relacionamentos
  budget      Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  items       BudgetItem[]
  
  @@map("budget_sections")
}

model BudgetItem {
  id              String      @id @default(cuid())
  sectionId       String
  code            String?
  description     String
  unit            String?
  quantity        Float       @default(0)
  unitPrice       Float       @default(0)
  totalPrice      Float       @default(0)
  formula         String?
  parameters      Json?
  order           Int
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relacionamentos
  section         BudgetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  @@map("budget_items")
}

model BudgetFormula {
  id          String      @id @default(cuid())
  budgetId    String
  name        String
  formula     String
  parameters  Json?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relacionamentos
  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  @@map("budget_formulas")
}

model BudgetAttachment {
  id          String      @id @default(cuid())
  budgetId    String
  name        String
  fileName    String
  fileUrl     String
  fileType    String
  fileSize    Int
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relacionamentos
  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  @@map("budget_attachments")
}

model BudgetVersion {
  id          String      @id @default(cuid())
  budgetId    String
  version     Int
  name        String
  description String?
  data        Json
  createdBy   String
  createdAt   DateTime    @default(now())
  
  // Relacionamentos
  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  @@unique([budgetId, version])
  @@map("budget_versions")
}

model BudgetApproval {
  id          String          @id @default(cuid())
  budgetId    String
  level       Int
  status      ApprovalStatus  @default(PENDING)
  comments    String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  // Relacionamentos
  budget      Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  @@map("budget_approvals")
}

// ========================================
// COMPOSIÇÕES E REFERÊNCIAS
// ========================================

model Composition {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  unit        String
  category    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relacionamentos
  items       CompositionItem[]
  
  @@map("compositions")
}

model CompositionItem {
  id            String      @id @default(cuid())
  compositionId String
  description   String
  unit          String
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  order         Int
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relacionamentos
  composition   Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  
  @@map("composition_items")
}

// ========================================
// ENUMS DO SISTEMA DE ORÇAMENTOS
// ========================================

enum BudgetStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum SectionType {
  QQP
  CPU
  BDI
  ENCARGOS
  FORMULAS
  PROPOSTA_TECNICA
  PROPOSTA_COMERCIAL
  ORDEM_SERVICO
}
